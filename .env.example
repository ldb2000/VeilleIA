# Fournisseur LLM : codex (défaut), openrouter ou gemini
LLM_PROVIDER=codex
LLM_TIMEOUT_SECONDS=90
LLM_REPORT_TIMEOUT_SECONDS=600

# Codex CLI : `npm install -g @openai/codex` puis `codex login` (compte ChatGPT ou clé OpenAI)
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=medium
# Recherche web live pendant la génération de la veille (true par défaut)
CODEX_WEB_SEARCH=true

# OpenRouter (pas de recherche internet, sauf plugin web payant avec OPENROUTER_WEB_SEARCH=true)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_WEB_SEARCH=false

# Gemini (ancien fournisseur, LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Reddit : signaux communautaires ajoutés au prompt de veille (désactivé par défaut)
REDDIT_ENABLED=false
# REDDIT_SUBREDDITS=LocalLLaMA,ClaudeAI,OpenAI,ChatGPTCoding,MachineLearning,singularity
# Flux RSS public, sans compte Reddit, une seule requête pour tous les subreddits
# (Reddit n'accepte qu'environ une requête anonyme par minute).
# REDDIT_MAX_POSTS=15
# REDDIT_MAX_POSTS_PER_SUB=5
# REDDIT_USER_AGENT=linux:veille-ia:1.0 (veille technique IA interne)
# REDDIT_TIMEOUT_SECONDS=10

# Mail (SMTP) : envoi de la newsletter (bouton « Envoyer par mail », POST /reports/{id}/send).
# Sans SMTP_HOST / MAIL_FROM / MAIL_TO, l'application fonctionne et l'envoi renvoie 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Mot de passe (ou mot de passe d'application) : jamais renvoyé par l'API ni écrit dans les logs.
SMTP_PASSWORD=
SMTP_STARTTLS=true
# SMTP_SSL=true          # SSL implicite (automatique sur le port 465)
# SMTP_TIMEOUT_SECONDS=30
# Expéditeur (défaut : SMTP_USER), ex. Veille IA <veille@april.fr>
MAIL_FROM=
# Destinataires séparés par des virgules
MAIL_TO=
# true : POST /cron/daily envoie la newsletter du jour (une seule fois)
MAIL_AUTO_SEND=false

API_TOKEN=your_api_token_here
VITE_API_TOKEN=your_api_token_here
ALLOWED_ORIGINS=http://localhost:5173
